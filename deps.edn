{:paths ["src" "resources"]
 :deps {babashka/fs {:mvn/version "0.5.24"}
        babashka/process {:mvn/version "0.5.22"}
        cheshire/cheshire {:mvn/version "5.13.0"}
        clj-commons/clj-yaml {:mvn/version "1.0.29"}
        com.amperity/vault-clj {:mvn/version "2.2.586"}
        com.taoensso/timbre {:mvn/version "6.6.1"}
        luposlip/json-schema {:mvn/version "0.4.6"}
        metosin/malli {:mvn/version "0.17.0"}
        org.clojure/clojure {:mvn/version "1.12.7"}
        org.clojure/tools.cli {:mvn/version "1.1.230"}
        org.clojure/tools.logging {:mvn/version "1.3.0"}
        selmer/selmer {:mvn/version "1.12.62"}}
 :aliases {:dev {:extra-paths ["dev" "test" "test-resources"]
                 :extra-deps {io.github.matthewdowney/rich-comment-tests {:mvn/version "v1.0.3"}
                              clj-test-containers/clj-test-containers {:mvn/version "0.7.4"}
                              ;; 0.7.4 pulls testcontainers 1.17.6, too old for Docker >= 29 (min API 1.40)
                              org.testcontainers/testcontainers {:mvn/version "1.21.4"}
                              com.fzakaria/slf4j-timbre {:mvn/version "0.4.1"}
                              djblue/portal {:mvn/version "0.58.5"
                                             ;; data.json > 2.4.0 does not work with bb - definterace
                                             :exclusions [org.clojure/data.json]}
                              org.slf4j/jcl-over-slf4j {:mvn/version "2.0.17"}
                              org.slf4j/jul-to-slf4j {:mvn/version "2.0.17"}
                              org.slf4j/log4j-over-slf4j {:mvn/version "2.0.17"}}}
           :test {:main-opts ["-m" "kaocha.runner"]
                  :extra-paths ["test" "test-resources"]
                  :extra-deps {io.github.matthewdowney/rich-comment-tests {:mvn/version "v1.0.3"}
                               clj-test-containers/clj-test-containers {:mvn/version "0.7.4"}
                               ;; 0.7.4 pulls testcontainers 1.17.6, too old for Docker >= 29 (min API 1.40)
                               org.testcontainers/testcontainers {:mvn/version "1.21.4"}
                               com.fzakaria/slf4j-timbre {:mvn/version "0.4.1"}
                               lambdaisland/kaocha {:mvn/version "1.91.1392"}
                               org.slf4j/jcl-over-slf4j {:mvn/version "2.0.17"}
                               org.slf4j/jul-to-slf4j {:mvn/version "2.0.17"}
                               org.slf4j/log4j-over-slf4j {:mvn/version "2.0.17"}}}
           :outdated {:deps {com.github.liquidz/antq {:mvn/version "RELEASE"}
                             org.slf4j/slf4j-simple {:mvn/version "2.0.17"}}
                      :main-opts ["-m" "antq.core"]}}}